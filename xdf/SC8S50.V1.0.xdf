    <CATEGORYMEM index="0" category="2" />
    <CATEGORYMEM index="1" category="3" />
    <XDFAXIS uniqueid="0x0" id="x">
      <indexcount>1</indexcount>
      <outputtype>4</outputtype>
      <DALINK index="0" />
      <MATH equation="X">
