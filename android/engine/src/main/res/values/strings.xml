<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The name the launcher and the app switcher show. "Quick Edit" survives as
      the internal name of the flow (and of the package, the classes, and the
      plan's V7/V8 units); it is only the user-facing product name that is
      simoscal, matching the library and the promo material.

      In-app the same name appears as the two-tone `Wordmark` composable — a
      logotype, drawn rather than set, exactly as the promo video draws it. That
      is the one place the string is deliberately not reused: a mark whose halves
      are separately coloured cannot be assembled from a translatable string, and
      pretending otherwise would only mean the mark broke the first time this
      value changed. If the product is ever renamed, both must move.
    -->
    <string name="app_name">simoscal</string>

    <!--
      The disclaimer is required on the Build screen. It draws the line the whole
      product depends on: the gates prove the *file* is what the journal says it
      is, and say nothing about whether the calibration is safe for an engine.
    -->
    <string name="build_disclaimer">
        Software verification is not mechanical safety. These checks prove the file
        changed only where you said it should and that its checksums are correct.
        They cannot tell you whether this calibration is safe for your engine —
        only logging on the car can.
    </string>

    <string name="preflight_blocked_title">This bin cannot be edited</string>
    <string name="choose_another_bin">Choose another bin</string>
    <string name="cancel">Cancel</string>
</resources>
